{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "api/board.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/board", "dest": "/api/board.js", "headers": { "Cache-Control": "no-store" } },
    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
